workflow ticket-to-pr {
  meta {
    title       = "Ticket to Pull Request"
    description = "Full development cycle — plan from ticket, implement, push PR, run review swarm, iterate until clean"
    trigger     = "manual"
    targets     = ["worktree"]
    group       = "Development"
  }

  inputs {
    ticket_id  required
    qualify    boolean
    auto_merge boolean
  }

  if qualify {
    call workflow qualify-ticket {
      inputs {
        ticket_id = "{{ticket_id}}"
      }
    }
  }

  call plan { output = "task-plan" }

  // A plan that needs the user's call stops here instead of implementing a
  // default nobody chose (#153). The answer reaches implement as gate_feedback.
  if plan.needs_decision {
    script show-plan-decisions {
      run = ".conductor/scripts/show-plan-decisions.sh"
      env = { PRIOR_OUTPUT = "{{prior_output}}" }
    }
    gate human_plan_decisions {
      prompt     = "The plan has decisions for you; the questions and the plan's defaults are in the show-plan-decisions step. Approve with your answers as feedback (approving without feedback keeps the defaults), or reject to stop the run."
      timeout    = "72h"
      on_timeout = fail
    }
  }

  call implement {
    retries = 2
    as      = "developer"
  }

  // implement can drop part of the plan without saying so, and verify checks
  // only that what was written builds and passes (#153). check-plan compares
  // the plan's tasks and tests with the diff; anything missing goes to a
  // dedicated agent before verify, so its work is verified too.
  call check-plan { output = "plan-check" }
  if check-plan.plan_incomplete {
    call complete-plan {
      retries = 1
      as      = "developer"
    }
  }

  script fmt-fix-pre-verify {
    run = ".conductor/scripts/fmt-fix.sh"
    env = {
      FMT_FIX_ALLOW_FAILURE = "1"
    }
  }
  script verify {
    run = ".conductor/scripts/verify.sh"
    env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
  }

  if verify.has_failures {
    call implement {
      retries = 1
      as      = "developer"
    }
    script fmt-fix-pre-reverify {
      run = ".conductor/scripts/fmt-fix.sh"
      env = {
        FMT_FIX_ALLOW_FAILURE = "1"
      }
    }
    script verify {
      run = ".conductor/scripts/verify.sh"
      env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
    }

    // Still failing after the retry: stop before lint-fix and push-and-pr
    // can open a PR with failing checks (#127).
    if verify.has_failures {
      script fail-verify {
        run = ".conductor/scripts/fail-verify.sh"
        env = { VERIFY_CONTEXT = "{{prior_context}}" }
      }
    }
  }

  call workflow lint-fix

  script fmt-fix {
    run = ".conductor/scripts/fmt-fix.sh"
  }

  script push-and-pr {
    run = ".conductor/scripts/push-and-pr.sh"
    as  = "developer"
    env = {
      FEATURE_BASE_BRANCH = "{{feature_base_branch}}"
      WORKTREE_BRANCH     = "{{worktree_branch}}"
    }
  }

  unless push-and-pr.no_changes {
    call workflow iterate-pr

    if auto_merge {
      gate pr_checks {
        timeout    = "2h"
        on_timeout = fail
      }

      gate pr_approval {
        as            = "reviewer"
        min_approvals = 1
        timeout       = "72h"
        on_timeout    = fail
      }

      call workflow rebase-worktree

      if rebase-worktree.has_conflicts {
        call workflow iterate-pr
      }

      gate pr_checks {
        timeout    = "2h"
        on_timeout = fail
      }

      script merge-and-close {
        run = ".conductor/scripts/merge-and-close.sh"
        as  = "merger"
        env = { TICKET_NUMBER = "{{ticket_source_id}}" }
      }
    }
  }
}
