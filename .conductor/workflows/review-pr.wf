workflow review-pr {
  meta {
    title       = "Review Pull Request"
    description = "Run review swarm and aggregate findings"
    trigger     = "manual"
    targets     = ["pr", "worktree"]
    group       = "Review"
  }

  inputs {
    scope default = "full"
    since default = ""
  }

  // Resolve the PR's base branch once at workflow start. Exposes it to all
  // downstream steps as {{base_branch}} via the engine's variable map.
  // Without this, reviewer agents and detect-* scripts each run their own
  // `gh pr view` and the silent fallback to `main` corrupts the diff. #2736.
  script resolve-pr-base {
    run     = ".conductor/scripts/resolve-pr-base.sh"
    retries = 1
  }
  script detect-file-types {
    run = ".conductor/scripts/detect-file-types.sh"
    env = {
      BASE_BRANCH = "{{base_branch}}"
      SCOPE       = "{{scope}}"
      SINCE       = "{{since}}"
    }
  }

  script detect-workflow-changes {
    run = ".conductor/scripts/detect-workflow-changes.sh"
    env = {
      BASE_BRANCH = "{{base_branch}}"
      SCOPE       = "{{scope}}"
      SINCE       = "{{since}}"
    }
  }

  parallel {
    output    = "review-findings"
    with      = ["review-diff-scope", "off-diff-findings"]
    fail_fast = false
    call review-architecture       { retries = 1 }
    call review-dry-abstraction    { retries = 1 }
    call review-security           { retries = 1  if = "detect-file-types.has_code_changes" }
    call review-performance        { retries = 1  if = "detect-file-types.has_code_changes" }
    call review-error-handling     { retries = 1  if = "detect-file-types.has_code_changes" }
    call review-test-coverage      { retries = 1  if = "detect-file-types.has_code_changes" }
    call review-workflow-semantics { retries = 1  if = "detect-workflow-changes.has_workflow_changes" }
  }

  // Replies posted on the PR since the last conductor review, so findings
  // that were already answered can be set aside (devinrosen/conductor-ai#3050).
  script fetch-pr-replies {
    run = ".conductor/scripts/fetch-pr-replies.sh"
    env = {
      PR_NUMBER = "{{pr_number}}"
    }
  }

  // Deciding whether a reply answers a finding is the only judgment left in
  // aggregation, so the agent runs only when there are replies (#152).
  if fetch-pr-replies.has_replies {
    call review-reply-check { output = "review-reply-check" retries = 1 }
  }

  // Deterministic: approval, blocking and off-diff findings and labels come
  // from the reviewers' outputs, with no model call (#152).
  script review-aggregator {
    run = ".conductor/scripts/aggregate-reviews.sh"
    env = {
      PRIOR_CONTEXTS = "{{prior_contexts}}"
    }
  }
  script submit-review {
    run = ".conductor/scripts/submit-review.sh"
    as  = "reviewer"
    env = {
      PRIOR_OUTPUT     = "{{prior_output}}"
      PR_NUMBER        = "{{pr_number}}"
      DRY_RUN          = "{{dry_run}}"
      TICKET_SOURCE_ID = "{{ticket_source_id}}"
      CONDUCTOR_REPO   = "{{repo_name}}"
    }
  }
}
